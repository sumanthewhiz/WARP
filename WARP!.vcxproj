  <Target Name="CopyOnnxRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(OrtRuntimeDir)\onnxruntime.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- ORT-GenAI runtime DLL (only when the package was restored). -->
    <Copy SourceFiles="$(OrtGenAiRuntimeDir)\onnxruntime-genai.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(HasOrtGenAi)'=='true' And Exists('$(OrtGenAiRuntimeDir)\onnxruntime-genai.dll')" />
    <Copy SourceFiles="$(ProjectDir)models\bge-small.onnx" DestinationFolder="$(OutDir)models\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)models\bge-small.onnx')" />
    <Copy SourceFiles="$(ProjectDir)models\minilm.onnx" DestinationFolder="$(OutDir)models\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)models\minilm.onnx')" />
    <Copy SourceFiles="$(ProjectDir)models\vocab.txt" DestinationFolder="$(OutDir)models\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)models\vocab.txt')" />
    <!-- Qwen2.5-0.5B-Instruct model files (optional polishing layer).
         The whole `models\qwen\` subtree is copied verbatim so any
         ORT-GenAI packaging shape (model.onnx + model.onnx.data,
         tokenizer.json, genai_config.json, etc.) works without
         enumerating every file individually. -->
    <ItemGroup>
      <QwenModelFiles Include="$(ProjectDir)models\qwen\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(QwenModelFiles)" DestinationFolder="$(OutDir)models\qwen\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(QwenModelFiles)'!=''" />
  </Target>
